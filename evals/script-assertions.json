{
  "version": 1,
  "contract": "references/scan-recipes.md",
  "ops": [
    "strict_json",
    "parity",
    "is_true",
    "is_false",
    "is_null",
    "is_empty_array",
    "is_nonempty_array",
    "equals",
    "contains",
    "not_contains",
    "matches",
    "count_gte",
    "unique_array",
    "raw_not_contains",
    "no_hang"
  ],
  "note": "paths use dot notation; [] expands each element. Expected values describe TARGET (post-fix) behaviour, so this table is RED before Phase 2 fixes.",
  "checks": [
    {
      "id": "all-strict-json",
      "fixtures": "*",
      "script": "*",
      "impl": "*",
      "op": "strict_json",
      "note": "每个脚本在两套实现下都必须是严格合法 JSON（RFC 8259：字符串内不得有裸控制字符）"
    },
    {
      "id": "all-parity",
      "fixtures": "*",
      "script": "*",
      "impl": "*",
      "op": "parity",
      "note": "scan-recipes.md 承诺两套实现同形 JSON：字段集一致 + 逐字段值一致"
    },
    {
      "id": "F1-notgit",
      "fixtures": [
        "F1"
      ],
      "script": "*",
      "impl": "*",
      "path": "is_git",
      "op": "is_false"
    },
    {
      "id": "F2-head-null",
      "fixtures": [
        "F2"
      ],
      "script": "git_state_snapshot",
      "impl": "*",
      "path": "head_short",
      "op": "is_null"
    },
    {
      "id": "F2-recent-empty",
      "fixtures": [
        "F2"
      ],
      "script": "git_state_snapshot",
      "impl": "*",
      "path": "recent_changed_files",
      "op": "is_empty_array"
    },
    {
      "id": "F3-detached",
      "fixtures": [
        "F3"
      ],
      "script": "git_state_snapshot",
      "impl": "*",
      "path": "detached",
      "op": "is_true"
    },
    {
      "id": "F3-branch-null",
      "fixtures": [
        "F3"
      ],
      "script": "git_state_snapshot",
      "impl": "*",
      "path": "current_branch",
      "op": "is_null"
    },
    {
      "id": "F4-vf-relative",
      "fixtures": [
        "F4"
      ],
      "script": "version_consistency_audit",
      "impl": "*",
      "path": "version_files[].file",
      "op": "not_contains",
      "value": "\\"
    },
    {
      "id": "F4-crlf-value",
      "fixtures": [
        "F4"
      ],
      "script": "version_consistency_audit",
      "impl": "*",
      "path": "distinct_versions",
      "op": "contains",
      "value": "9.9.9"
    },
    {
      "id": "F4-untracked-todo",
      "fixtures": [
        "F4"
      ],
      "script": "next_steps_analysis",
      "impl": "*",
      "path": "todo_fixme",
      "op": "count_gte",
      "value": 1
    },
    {
      "id": "F5-dirty",
      "fixtures": [
        "F5"
      ],
      "script": "git_state_snapshot",
      "impl": "*",
