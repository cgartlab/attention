{
  "version": 1,
  "contract": "references/scan-recipes.md",
  "ops": [
    "strict_json",
    "parity",
    "is_true",
    "is_false",
    "is_null",
    "is_empty_array",
    "is_nonempty_array",
    "equals",
    "contains",
    "not_contains",
    "matches",
    "count_gte",
    "unique_array",
    "raw_not_contains",
    "no_hang"
  ],
  "note": "paths use dot notation; [] expands each element. Expected values describe TARGET (post-fix) behaviour, so this table is RED before Phase 2 fixes.",
  "checks": [
    {
      "id": "all-strict-json",
      "fixtures": "*",
      "script": "*",
      "impl": "*",
      "op": "strict_json",
      "note": "每个脚本在两套实现下都必须是严格合法 JSON（RFC 8259：字符串内不得有裸控制字符）"
    },
    {
      "id": "all-parity",
      "fixtures": "*",
      "script": "*",
      "impl": "*",
      "op": "parity",
      "note": "scan-recipes.md 承诺两套实现同形 JSON：字段集一致 + 逐字段值一致"
    },
    {
      "id": "F1-notgit",
      "fixtures": [
        "F1"
      ],
      "script": "*",
